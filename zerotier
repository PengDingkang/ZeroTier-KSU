#!/system/bin/sh

path="/data/adb/zerotier"
module_dir="/data/adb/modules/ZeroTier-KSU"
bin_name="zerotier-one"

# Internal calls always use the private tool, independent of command mounting.
bin_path="$path/$bin_name"

pid_file="$path/zerotier-one.pid"
token_file="$path/authtoken.secret"
autostart_file="$path/autostart.conf"
log_file="$path/error.log"

# find busybox across Magisk/KSU/APatch
for bb in /data/adb/magisk/busybox /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox; do
  [ -f "$bb" ] && busybox="$bb" && break
done
# fallback to PATH
[ -z "$busybox" ] && busybox="busybox"

bin_status() {
  [ "$($busybox pidof "$bin_name")" ] && return 0 || return 1
}

get_command_mount() {
  if [ -f "$module_dir/skip_mount" ]; then
    echo 0
  else
    echo 1
  fi
}

is_mounting_metamodule() {
  [ -f "$1/module.prop" ] && [ -f "$1/metamount.sh" ] || return 1
  [ ! -e "$1/disable" ] && [ ! -e "$1/remove" ] || return 1
  awk -F= '
    { key = $1; value = $2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", value) }
    key == "metamodule" && (value == "1" || tolower(value) == "true") { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$1/module.prop"
}

command_mount_supported() {
  # The installer records the framework so WebUI/terminal environments need
  # not export KSU or APATCH. Magisk and APatch provide their own mounting.
  case "$(cat "$path/root_framework" 2>/dev/null)" in
    magisk|apatch) return 0 ;;
  esac

  mount_modules="${module_dir%/*}"
  mount_meta="${mount_modules%/*}/metamodule"
  # Prefer KernelSU's selected provider; a disabled provider is unavailable.
  if [ -d "$mount_meta" ]; then
    is_mounting_metamodule "$mount_meta"
    return $?
  fi
  for mount_provider in "$mount_modules"/*; do
    is_mounting_metamodule "$mount_provider" && return 0
  done
  return 1
}

# Called by both the installer and the settings command. Keep private tools
# authoritative; create system copies only when mounting is requested.
prepare_command_mount() {
  cm_target="$1"
  cm_enabled="$2"
  case "$cm_enabled" in 0|1) ;; *) return 1 ;; esac
  [ -d "$cm_target" ] || return 1
  [ ! -L "$cm_target/system" ] && [ ! -L "$cm_target/system/bin" ] || return 1
  if [ "$cm_enabled" = 0 ]; then
    touch "$cm_target/skip_mount" || return 1
    for cm_tool in zerotier-one zerotier zerotier-cli zerotier-idtool; do
      rm -f "$cm_target/system/bin/$cm_tool" || return 1
    done
    rmdir "$cm_target/system/bin" "$cm_target/system" 2>/dev/null || true
    return 0
  fi
  cm_tmp=$(mktemp -d "$cm_target/.command-mount.XXXXXX") || return 1
  if ! (
    for cm_tool in zerotier-one zerotier; do
      cp "$path/$cm_tool" "$cm_tmp/$cm_tool" || exit 1
      chmod 755 "$cm_tmp/$cm_tool" || exit 1
    done
    for cm_alias in zerotier-cli zerotier-idtool; do
      ln -s zerotier-one "$cm_tmp/$cm_alias" || exit 1
    done
    mkdir -p "$cm_target/system/bin" || exit 1
    for cm_tool in zerotier-one zerotier zerotier-cli zerotier-idtool; do
      mv -f "$cm_tmp/$cm_tool" "$cm_target/system/bin/$cm_tool" || exit 1
    done
  ); then
    rm -rf "$cm_tmp"
    return 1
  fi
  rm -rf "$cm_tmp"
  rm -f "$cm_target/skip_mount"
}

set_command_mount() {
  mount_enabled="$1"
  if [ ! -d "$module_dir" ]; then
    echo "ERROR: ZeroTier module directory not found" >&2
    return 1
  fi
  if [ "$mount_enabled" = 1 ] && ! command_mount_supported; then
    echo "ERROR: No mount provider available; KernelSU requires an enabled mounting metamodule" >&2
    return 1
  fi
  mkdir -p "$path" || return 1
  mount_previous=$(get_command_mount)
  mount_parent="${module_dir%/*}"
  mount_pending="${mount_parent%/*}/modules_update/${module_dir##*/}"
  mount_pending_previous=1
  [ ! -f "$mount_pending/skip_mount" ] || mount_pending_previous=0
  mount_tmp=$(mktemp "$path/.mount_enabled.XXXXXX") || return 1
  if ! printf '%s\n' "$mount_enabled" > "$mount_tmp"; then
    rm -f "$mount_tmp"
    return 1
  fi
  mount_saved=0
  if prepare_command_mount "$module_dir" "$mount_enabled"; then
    if [ ! -d "$mount_pending" ] || prepare_command_mount "$mount_pending" "$mount_enabled"; then
      if mv -f "$mount_tmp" "$path/mount_enabled"; then mount_saved=1; fi
    fi
  fi
  if [ "$mount_saved" != 1 ]; then
    prepare_command_mount "$module_dir" "$mount_previous" || true
    if [ -d "$mount_pending" ]; then
      prepare_command_mount "$mount_pending" "$mount_pending_previous" || true
    fi
    rm -f "$mount_tmp"
    echo "ERROR: Cannot save shell command mount setting" >&2
    return 1
  fi
  echo "Shell command mount saved; reboot to apply"
}

get_autostart() {
  AUTO_START=1
  # shellcheck disable=SC1090
  [ -f "$autostart_file" ] && . "$autostart_file"
  echo "${AUTO_START:-1}"
}

set_autostart() {
  mkdir -p "$path"
  printf "AUTO_START=%s\n" "$1" > "$autostart_file"
}

zt_api() {
  if [ ! -f "$token_file" ]; then
    echo "ERROR: auth token not found (service not started yet?)"
    return 1
  fi
  token=$(cat "$token_file")
  curl -sf -H "X-ZT1-Auth: ${token}" "http://127.0.0.1:9993${1}" 2>/dev/null
}

zt_api_post() {
  if [ ! -f "$token_file" ]; then
    echo "ERROR: auth token not found"
    return 1
  fi
  token=$(cat "$token_file")
  curl -sf -X POST -H "X-ZT1-Auth: ${token}" -d "${2:-{}}" "http://127.0.0.1:9993${1}" 2>/dev/null
}

zt_api_delete() {
  if [ ! -f "$token_file" ]; then
    echo "ERROR: auth token not found"
    return 1
  fi
  token=$(cat "$token_file")
  curl -sf -X DELETE -H "X-ZT1-Auth: ${token}" "http://127.0.0.1:9993${1}" 2>/dev/null
}

# update KSU module description
update_desc() {
  command -v ksud >/dev/null 2>&1 || return
  export KSU_MODULE="ZeroTier-KSU"
  if bin_status; then
    ip=$(zt_api "/network" | grep -o '"assignedAddresses":\["[^"]*"' | head -1 | sed 's/.*\["\([^/]*\).*/\1/')
    if [ -n "$ip" ]; then
      ksud module config set override.description "✅ Running | IP: ${ip}" 2>/dev/null
    else
      ksud module config set override.description "✅ Running" 2>/dev/null
    fi
  else
    ksud module config set override.description "⏹ Stopped" 2>/dev/null
  fi
}

display_bin_status() {
  if bin_status; then
    printf "\033[32m● zerotier-one is running (pid: %s)\033[0m\n" "$($busybox pidof "$bin_name")"
    # show node info
    info=$(zt_api "/status")
    if [ -n "$info" ]; then
      node_id=$(echo "$info" | grep -o '"address":"[^"]*"' | sed 's/"address":"//;s/"//')
      version=$(echo "$info" | grep -o '"version":"[^"]*"' | sed 's/"version":"//;s/"//')
      printf "  Node ID: %s\n" "$node_id"
      printf "  Version: %s\n" "$version"
    fi
    # show joined networks
    nets=$(zt_api "/network")
    if [ -n "$nets" ] && [ "$nets" != "[]" ]; then
      printf "  Networks:\n"
      echo "$nets" | grep -o '"nwid":"[^"]*"\|"name":"[^"]*"\|"status":"[^"]*"\|"assignedAddresses":\[[^]]*\]' | \
        paste - - - - 2>/dev/null | while IFS= read -r line; do
          nwid=$(echo "$line" | grep -o '"nwid":"[^"]*"' | sed 's/"nwid":"//;s/"//')
          name=$(echo "$line" | grep -o '"name":"[^"]*"' | sed 's/"name":"//;s/"//')
          status=$(echo "$line" | grep -o '"status":"[^"]*"' | sed 's/"status":"//;s/"//')
          addrs=$(echo "$line" | grep -o '"assignedAddresses":\[[^]]*\]' | sed 's/"assignedAddresses":\[//;s/\]//;s/"//g')
          printf "    %s (%s) [%s] %s\n" "$nwid" "$name" "$status" "$addrs"
        done
    fi
  else
    printf "\033[31m● zerotier-one is stopped\033[0m\n"
  fi
  if [ "$(get_autostart)" = "1" ]; then
    printf "● boot auto start: enabled\n"
  else
    printf "● boot auto start: disabled\n"
  fi
  update_desc
}

start_service() {
  if bin_status; then
    echo "${bin_name} is already running"
    return
  fi
  mkdir -p "$path/networks.d" "$path/moons.d"
  chmod 700 "$path"
  nohup "$bin_path" "$path" > /dev/null 2> "$log_file" &
  echo "$!" > "$pid_file"
  sleep 2
  ip rule add from all lookup main pref 1 2>/dev/null
  if bin_status; then
    echo "start success"
  else
    echo "start failed, check $log_file"
  fi
}

stop_service() {
  if bin_status; then
    echo "stopping ${bin_name}..."
    kill "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null || killall "$bin_name" 2>/dev/null
    i=0
    while bin_status && [ $i -lt 20 ]; do
      sleep 0.5
      i=$((i + 1))
    done
    bin_status && kill -9 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null
    ip rule del from all lookup main pref 1 2>/dev/null
  else
    echo "${bin_name} is already stopped"
  fi
  rm -f "$pid_file" 2>/dev/null
}

join_network() {
  if [ -z "$1" ]; then
    echo "Usage: zerotier join <network_id>"
    return 1
  fi
  if ! bin_status; then
    echo "ERROR: zerotier-one is not running, start it first"
    return 1
  fi
  result=$(zt_api_post "/network/$1")
  if [ -n "$result" ]; then
    echo "Joined network $1"
    # persist network
    echo "{}" > "$path/networks.d/$1.conf" 2>/dev/null
  else
    echo "Failed to join network $1"
  fi
}

leave_network() {
  if [ -z "$1" ]; then
    echo "Usage: zerotier leave <network_id>"
    return 1
  fi
  if ! bin_status; then
    echo "ERROR: zerotier-one is not running"
    return 1
  fi
  zt_api_delete "/network/$1" > /dev/null
  rm -f "$path/networks.d/$1.conf" 2>/dev/null
  echo "Left network $1"
}

case "$1" in
  prepare-command-mount) prepare_command_mount "$2" "$3" ;;
  mount)
    case "$2" in
      enable) set_command_mount 1 ;;
      disable) set_command_mount 0 ;;
      status|"") get_command_mount ;;
      supported) if command_mount_supported; then echo 1; else echo 0; fi ;;
      *) echo "Usage: zerotier mount {enable|disable|status|supported}" >&2; exit 1 ;;
    esac
    ;;
  start)     start_service; display_bin_status ;;
  stop)      stop_service; display_bin_status ;;
  restart)   stop_service; start_service; display_bin_status ;;
  status)    display_bin_status ;;
  enable)    set_autostart 1; echo "boot auto start: enabled" ;;
  disable)   set_autostart 0; echo "boot auto start: disabled" ;;
  join)      join_network "$2" ;;
  leave)     leave_network "$2" ;;
  *)         echo "Usage: zerotier {start|stop|restart|status|enable|disable|join|leave}; zerotier mount {enable|disable|status|supported}" ;;
esac
